// 1. Force IRremote to use AVR Timer 1 BEFORE headers
#define IR_USE_AVR_TIMER1 

#include <IRremote.hpp>
#include <SoftwareSerial.h>
#include <Wire.h>

// --- PIN DEFINITIONS ---
#define LDR_PIN       A0
#define CO2_PIN       A1   // MQ-135 CO2 Sensor
#define MOISTURE_PIN  A3   // Soil Moisture Sensor

#define IR_RECEIVE_PIN 8

// Shift Register #1: U14 (LCD Driver)
#define SR1_DS_PIN    2
#define SR1_SHCP_PIN  3
#define SR1_STCP_PIN  4

// Shift Register #2: U16 (Relay Driver)
#define SR2_DS_PIN    5
#define SR2_SHCP_PIN  6
#define SR2_STCP_PIN  7

// Bluetooth HC-06 (U7)
#define BT_RX_PIN     13
#define BT_TX_PIN     11
#define BT_STATE_PIN  12

// --- IR REMOTE BUTTON CODES ---
#define IR_BTN_UP     0x18
#define IR_BTN_DOWN   0x52
#define IR_BTN_RIGHT  0x5A
#define IR_BTN_LEFT   0x08
#define IR_BTN_OK     0x1C

SoftwareSerial btSerial(BT_RX_PIN, BT_TX_PIN);

// Sensor Data Holders
int ldrValue = 0;
int co2Value = 0;
int moistureValue = 0;
float temperature = 0.0;
float humidity = 0.0;

// Relays & Display Control
byte relayState = 0x00;        // Bitmask: 1 = ON, 0 = OFF
int currentLcdPage = 0;        // 0: Welcome Banner, 1: Temp/Humid, 2: CO2 & Soil, 3: Light & Relays, 4: Relay Select
int selectedRelayIndex = 0;    // 0 to 4 (Relays 1 to 5)

unsigned long lastSensorRead = 0;
unsigned long lastSerialSend = 0;
unsigned long lastMarqueeScroll = 0;
unsigned long lastIrPressTime = 0;

int marqueeIndex = 0;
const char welcomeText[] = "   we are pleased to have here with us and welcome to smartmushroom farm a product of JHUB .   ";
const int welcomeLen = sizeof(welcomeText) - 1;

// --- SHIFT REGISTER HELPERS ---
void writeShiftRegister(int dsPin, int shcpPin, int stcpPin, byte data) {
  digitalWrite(stcpPin, LOW);
  shiftOut(dsPin, shcpPin, MSBFIRST, data);
  digitalWrite(stcpPin, HIGH);
}

// --- LCD CONTROL VIA SHIFT REGISTER U14 ---
void lcdPulseEnable(byte srData) {
  writeShiftRegister(SR1_DS_PIN, SR1_SHCP_PIN, SR1_STCP_PIN, srData | 0x02);
  delayMicroseconds(1);
  writeShiftRegister(SR1_DS_PIN, SR1_SHCP_PIN, SR1_STCP_PIN, srData & ~0x02);
  delayMicroseconds(50);
}

void lcdSendNibble(byte nibble, bool isData) {
  byte srData = isData ? 0x01 : 0x00;
  srData |= ((nibble & 0x0F) << 2);
  writeShiftRegister(SR1_DS_PIN, SR1_SHCP_PIN, SR1_STCP_PIN, srData);
  lcdPulseEnable(srData);
}

void lcdCommand(byte cmd) {
  lcdSendNibble(cmd >> 4, false);
  lcdSendNibble(cmd & 0x0F, false);
  delay(2);
}

void lcdWriteChar(char ch) {
  lcdSendNibble(ch >> 4, true);
  lcdSendNibble(ch & 0x0F, true);
}

void lcdPrintString(const char* str) {
  while (*str) {
    lcdWriteChar(*str++);
  }
}

void initLCD() {
  delay(50);
  lcdSendNibble(0x03, false); delay(5);
  lcdSendNibble(0x03, false); delay(5);
  lcdSendNibble(0x03, false); delay(1);
  lcdSendNibble(0x02, false); 

  lcdCommand(0x28); // 4-bit, 2 lines, 5x8
  lcdCommand(0x0C); // Display ON, Cursor OFF
  lcdCommand(0x01); // Clear screen
  delay(2);
}

void setLcdCursor(uint8_t col, uint8_t row) {
  uint8_t rowOffsets[] = {0x00, 0x40};
  lcdCommand(0x80 | (col + rowOffsets[row]));
}

// --- RELAY CONTROL VIA SHIFT REGISTER U16 ---
// Active-LOW relay module: Invert bits (~state) so 1 in memory = Relay ACTIVE
void updateRelays(byte state) {
  relayState = state;
  writeShiftRegister(SR2_DS_PIN, SR2_SHCP_PIN, SR2_STCP_PIN, ~relayState);
}

// --- I2C DHT READ (A4/SDA, A5/SCL) ---
void readI2CDHT() {
  Wire.beginTransmission(0x38); // Standard I2C address for AHT20/DHT20
  Wire.write(0xAC);
  Wire.write(0x33);
  Wire.write(0x00);
  if (Wire.endTransmission() == 0) {
    delay(80);
    Wire.requestFrom(0x38, 6);
    if (Wire.available() >= 6) {
      byte data[6];
      for (int i = 0; i < 6; i++) data[i] = Wire.read();
      
      uint32_t rawHum = (((uint32_t)data[1] << 12) | ((uint32_t)data[2] << 4) | (data[3] >> 4));
      uint32_t rawTemp = ((((uint32_t)data[3] & 0x0F) << 16) | ((uint32_t)data[4] << 8) | data[5]);
      
      humidity = ((float)rawHum / 1048576.0) * 100.0;
      temperature = (((float)rawTemp / 1048576.0) * 200.0) - 50.0;
    }
  }
}

// --- LCD DISPLAY REFRESH ---
void updateLCDDisplay() {
  lcdCommand(0x01);
  delay(2);

  if (currentLcdPage == 0) {
    // Default Welcome Banner
    setLcdCursor(0, 0);
    lcdPrintString("SmartMushroom");
    setLcdCursor(0, 1);
    char buffer[17];
    for (int i = 0; i < 16; i++) {
      buffer[i] = welcomeText[(marqueeIndex + i) % welcomeLen];
    }
    buffer[16] = '\0';
    lcdPrintString(buffer);
  } 
  else if (currentLcdPage == 1) {
    // Climate Page
    setLcdCursor(0, 0);
    lcdPrintString("Temp : "); lcdPrintString(String(temperature, 1).c_str()); lcdPrintString("C");
    setLcdCursor(0, 1);
    lcdPrintString("Humid: "); lcdPrintString(String(humidity, 1).c_str()); lcdPrintString("%");
  } 
  else if (currentLcdPage == 2) {
    // Air & Soil Page
    setLcdCursor(0, 0);
    lcdPrintString("CO2  : "); lcdPrintString(String(co2Value).c_str()); lcdPrintString(" PPM");
    setLcdCursor(0, 1);
    lcdPrintString("Moist: "); lcdPrintString(String(moistureValue).c_str());
  } 
  else if (currentLcdPage == 3) {
    // Light & Relay Status Overview
    setLcdCursor(0, 0);
    lcdPrintString("LDR  : "); lcdPrintString(String(ldrValue).c_str());
    setLcdCursor(0, 1);
    lcdPrintString("Relays: ");
    for (int i = 0; i < 5; i++) {
      lcdWriteChar((relayState & (1 << i)) ? '1' : '0');
    }
  }
  else if (currentLcdPage == 4) {
    // Relay Interactive Toggle Page
    setLcdCursor(0, 0);
    lcdPrintString("Select Relay: R"); lcdPrintString(String(selectedRelayIndex + 1).c_str());
    setLcdCursor(0, 1);
    lcdPrintString("Status: ");
    lcdPrintString((relayState & (1 << selectedRelayIndex)) ? "ON " : "OFF");
  }
}

// --- COMMAND PARSER (FROM ESP32 & BLUETOOTH) ---
void processActuatorCommand(String cmd) {
  cmd.trim();
  if (cmd.startsWith("R") && cmd.length() >= 4) {
    int relayNum = cmd.substring(1, 2).toInt();
    if (relayNum >= 1 && relayNum <= 5) {
      if (cmd.endsWith("_ON")) {
        relayState |= (1 << (relayNum - 1));
      } else if (cmd.endsWith("_OFF")) {
        relayState &= ~(1 << (relayNum - 1));
      }
    }
  } else if (cmd == "RALL_ON") {
    relayState = 0x1F;
  } else if (cmd == "RALL_OFF") {
    relayState = 0x00;
  }

  updateRelays(relayState);
  if (currentLcdPage == 4 || currentLcdPage == 3) {
    updateLCDDisplay();
  }
}

void setup() {
  // Serial to ESP32-CAM (Hardware Serial: RX0 / TX1)
  Serial.begin(115200);

  // Bluetooth HC-06
  btSerial.begin(9600);
  pinMode(BT_STATE_PIN, INPUT);

  // I2C Bus for DHT
  Wire.begin();

  // Shift Register Output Pins
  pinMode(SR1_DS_PIN, OUTPUT);
  pinMode(SR1_SHCP_PIN, OUTPUT);
  pinMode(SR1_STCP_PIN, OUTPUT);

  pinMode(SR2_DS_PIN, OUTPUT);
  pinMode(SR2_SHCP_PIN, OUTPUT);
  pinMode(SR2_STCP_PIN, OUTPUT);

  // Initialize Relays OFF (Active Low output = HIGH)
  updateRelays(0x00);
  initLCD();

  // IR Receiver Setup
  IrReceiver.begin(IR_RECEIVE_PIN, DISABLE_LED_FEEDBACK);

  updateLCDDisplay();
}

void loop() {
  // 1. Analog & I2C Sensor Sampling (Every 500ms)
  if (millis() - lastSensorRead > 500) {
    lastSensorRead = millis();
    ldrValue      = analogRead(LDR_PIN);
    co2Value      = analogRead(CO2_PIN);
    moistureValue = analogRead(MOISTURE_PIN);
    readI2CDHT();
  }

  // 2. Marquee Text Auto-Scroll on Page 0
  if (currentLcdPage == 0 && millis() - lastMarqueeScroll > 350) {
    lastMarqueeScroll = millis();
    marqueeIndex = (marqueeIndex + 1) % welcomeLen;
    updateLCDDisplay();
  }

  // 3. Return to Welcome Page after 10 seconds of IR inactivity
  if (currentLcdPage != 0 && (millis() - lastIrPressTime > 10000)) {
    currentLcdPage = 0;
    updateLCDDisplay();
  }

  // 4. Decode IR Remote Controls
  if (IrReceiver.decode()) {
    if (!(IrReceiver.decodedIRData.flags & IRDATA_FLAGS_IS_REPEAT)) {
      uint16_t command = IrReceiver.decodedIRData.command;
      lastIrPressTime = millis();

      switch (command) {
        case IR_BTN_RIGHT: // Next LCD Page (0 -> 4)
          currentLcdPage = (currentLcdPage + 1) % 5;
          updateLCDDisplay();
          break;

        case IR_BTN_LEFT:  // Previous LCD Page
          currentLcdPage = (currentLcdPage + 4) % 5;
          updateLCDDisplay();
          break;

        case IR_BTN_UP:    // Switch Selected Relay (1 to 5)
          selectedRelayIndex = (selectedRelayIndex + 1) % 5;
          currentLcdPage = 4;
          updateLCDDisplay();
          break;

        case IR_BTN_DOWN:  // Switch Selected Relay Down
          selectedRelayIndex = (selectedRelayIndex + 4) % 5;
          currentLcdPage = 4;
          updateLCDDisplay();
          break;

        case IR_BTN_OK:    // Toggle Selected Relay State
          relayState ^= (1 << selectedRelayIndex);
          updateRelays(relayState);
          currentLcdPage = 4;
          updateLCDDisplay();
          break;

        default:
          break;
      }
    }
    IrReceiver.resume();
  }

  // 5. Receive Web Actuator Commands from ESP32-CAM via Hardware Serial (RX0)
  if (Serial.available()) {
    String espCmd = Serial.readStringUntil('\n');
    processActuatorCommand(espCmd);
  }

  // 6. Receive Actuator Commands from Bluetooth HC-06
  if (btSerial.available()) {
    String btCmd = btSerial.readStringUntil('\n');
    processActuatorCommand(btCmd);
  }

  // 7. Stream Telemetry JSON to ESP32-CAM (TX1) & Bluetooth (Every 1s)
  if (millis() - lastSerialSend > 1000) {
    lastSerialSend = millis();

    String telemetry = "{\"CO2\":" + String(co2Value) + 
                       ",\"MST\":" + String(moistureValue) + 
                       ",\"LDR\":" + String(ldrValue) + 
                       ",\"TMP\":" + String(temperature, 1) + 
                       ",\"HUM\":" + String(humidity, 1) + 
                       ",\"RLY\":" + String(relayState) + "}";

    Serial.println(telemetry);   // Sent directly to ESP32-CAM RX
    btSerial.println(telemetry); // Sent to HC-06 Bluetooth
  }
}

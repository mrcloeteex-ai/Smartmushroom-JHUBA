#include <WiFi.h>
#include <WebServer.h>
#include <PubSubClient.h>

#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEScan.h>
#include <BLEClient.h>

// =========================================================
// WI-FI & MQTT CONFIGURATION
// =========================================================
const char* ssid          = "ABCD";
const char* password      = "12345678";

const char* mqtt_server   = "192.168.43.100";
const int   mqtt_port     = 1883;
const char* mqtt_client_id= "ESP32_SmartMushroom";

const char* mqtt_sensor_topic = "mushroom/sensors";
const char* mqtt_fan_topic    = "mushroom/fan";
const char* mqtt_heater_topic = "mushroom/heater";
const char* mqtt_light_topic  = "mushroom/light";
const char* mqtt_status_topic = "mushroom/status";

WiFiClient espClient;
PubSubClient mqttClient(espClient);
WebServer server(80);

// =========================================================
// SENSIRION SHT40 BLE UUIDs
// =========================================================
static BLEUUID humidityService("00001234-b38d-4985-720e-0f993a68ee41");
static BLEUUID humidityChar("00001235-b38d-4985-720e-0f993a68ee41");
static BLEUUID temperatureService("00002234-b38d-4985-720e-0f993a68ee41");
static BLEUUID temperatureChar("00002235-b38d-4985-720e-0f993a68ee41");

BLEAdvertisedDevice* targetDevice = nullptr;
BLEClient*           pClient      = nullptr;
BLERemoteCharacteristic* pHumChar  = nullptr;
BLERemoteCharacteristic* pTempChar = nullptr;

bool isConnected = false;
bool doConnect   = false;

// =========================================================
// TELEMETRY VARIABLES
// =========================================================
float temperature = 0.0;
float humidity    = 0.0;
int   co2Value    = 0;
int   moistureVal = 0;
int   ldrVal      = 0;
byte  relayState  = 0x00;

String rxBuffer = "";

// Timers
unsigned long lastBleRead     = 0;
unsigned long lastMqttPublish = 0;
unsigned long lastWiFiCheck   = 0;

const unsigned long mqttPublishInterval = 5000;
const unsigned long wifiCheckInterval   = 5000;

float bytesToFloat(std::string value) {
  if (value.length() != 4) return NAN;
  union { uint8_t b[4]; float f; } data;
  for (int i = 0; i < 4; i++) data.b[i] = value[i];
  return data.f;
}

class MyAdvertisedDeviceCallbacks : public BLEAdvertisedDeviceCallbacks {
  void onResult(BLEAdvertisedDevice advertisedDevice) {
    if (advertisedDevice.haveName() &&
       (advertisedDevice.getName() == "SHT40 Gadget" ||
        advertisedDevice.getName().find("Smart Gadget") != std::string::npos)) {
      BLEDevice::getScan()->stop();
      targetDevice = new BLEAdvertisedDevice(advertisedDevice);
      doConnect = true;
    }
  }
};

bool connectToSensor() {
  pClient = BLEDevice::createClient();
  if (!pClient->connect(targetDevice)) return false;

  BLERemoteService* pHumService = pClient->getService(humidityService);
  if (pHumService != nullptr) pHumChar = pHumService->getCharacteristic(humidityChar);

  BLERemoteService* pTempService = pClient->getService(temperatureService);
  if (pTempService != nullptr) pTempChar = pTempService->getCharacteristic(temperatureChar);

  if (pHumChar == nullptr || pTempChar == nullptr) {
    pClient->disconnect();
    return false;
  }
  return true;
}

void reconnectMQTT() {
  if (WiFi.status() != WL_CONNECTED) return;
  if (!mqttClient.connected()) {
    String clientId = mqtt_client_id;
    clientId += "_" + String((uint32_t)ESP.getEfuseMac(), HEX);

    if (mqttClient.connect(clientId.c_str())) {
      mqttClient.publish(mqtt_status_topic, "ESP32 Gateway Connected", true);
      mqttClient.subscribe(mqtt_fan_topic);
      mqttClient.subscribe(mqtt_heater_topic);
      mqttClient.subscribe(mqtt_light_topic);
    }
  }
}

void mqttCallback(char* topic, byte* payload, unsigned int length) {
  String msg = "";
  for (unsigned int i = 0; i < length; i++) msg += (char)payload[i];
  msg.trim();

  if (String(topic) == mqtt_fan_topic) {
    Serial.println(msg.equalsIgnoreCase("ON") ? "R1_ON" : "R1_OFF");
  } else if (String(topic) == mqtt_heater_topic) {
    Serial.println(msg.equalsIgnoreCase("ON") ? "R2_ON" : "R2_OFF");
  } else if (String(topic) == mqtt_light_topic) {
    Serial.println(msg.equalsIgnoreCase("ON") ? "R3_ON" : "R3_OFF");
  }
}

void publishSensorData() {
  if (!mqttClient.connected()) return;

  String payload = "{";
  payload += "\"co2\":" + String(co2Value) + ",";
  payload += "\"moisture\":" + String(moistureVal) + ",";
  payload += "\"light\":" + String(ldrVal) + ",";
  payload += "\"temperature\":" + String(temperature, 1) + ",";
  payload += "\"humidity\":" + String(humidity, 1) + ",";
  payload += "\"relays\":" + String(relayState);
  payload += "}";

  mqttClient.publish(mqtt_sensor_topic, payload.c_str());
}


void handleRoot()     { server.send(200, "text/html", HTML_PAGE); }
void handleCmd()      { if (server.hasArg("action")) Serial.println(server.arg("action")); server.send(200, "text/plain", "OK"); }
void handleReadData() {
  String json = "{";
  json += "\"co2\":" + String(co2Value) + ",";
  json += "\"mst\":" + String(moistureVal) + ",";
  json += "\"ldr\":" + String(ldrVal) + ",";
  json += "\"tmp\":" + String(temperature) + ",";
  json += "\"hum\":" + String(humidity) + ",";
  json += "\"rly\":" + String(relayState);
  json += "}";
  server.send(200, "application/json", json);
}

// Parse Serial Stream from Arduino Uno
void processSerialInput() {
  while (Serial.available()) {
    char c = (char)Serial.read();
    if (c == '\n') {
      rxBuffer.trim();
      if (rxBuffer.startsWith("{") && rxBuffer.endsWith("}")) {
        int co2Start = rxBuffer.indexOf("\"CO2\":");
        int mstStart = rxBuffer.indexOf("\"MST\":");
        int ldrStart = rxBuffer.indexOf("\"LDR\":");
        int tmpStart = rxBuffer.indexOf("\"TMP\":");
        int humStart = rxBuffer.indexOf("\"HUM\":");
        int rlyStart = rxBuffer.indexOf("\"RLY\":");

        if (co2Start >= 0 && mstStart > co2Start) co2Value    = rxBuffer.substring(co2Start + 6, mstStart - 1).toInt();
        if (mstStart >= 0 && ldrStart > mstStart) moistureVal = rxBuffer.substring(mstStart + 6, ldrStart - 1).toInt();
        if (ldrStart >= 0 && tmpStart > ldrStart) ldrVal      = rxBuffer.substring(ldrStart + 6, tmpStart - 1).toInt();
        
        // Fallback temperature & humidity from Arduino (if BLE SHT40 disconnected)
        if (!isConnected) {
          if (tmpStart >= 0 && humStart > tmpStart) temperature = rxBuffer.substring(tmpStart + 6, humStart - 1).toFloat();
          if (humStart >= 0 && rlyStart > humStart) humidity    = rxBuffer.substring(humStart + 6, rlyStart - 1).toFloat();
        }

        if (rlyStart >= 0) {
          int endBracket = rxBuffer.indexOf("}", rlyStart);
          relayState = rxBuffer.substring(rlyStart + 6, endBracket).toInt();
        }
      }
      rxBuffer = "";
    } else {
      rxBuffer += c;
    }
  }
}

void setup() {
  // Use Hardware Serial (U0RX / U0TX) at 115200 baud
  Serial.begin(115200);

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) { delay(250); }

  mqttClient.setServer(mqtt_server, mqtt_port);
  mqttClient.setCallback(mqttCallback);

  server.on("/", handleRoot);
  server.on("/readData", handleReadData);
  server.on("/cmd", handleCmd);
  server.begin();

  BLEDevice::init("ESP32_Gateway");
  BLEScan* pBLEScan = BLEDevice::getScan();
  pBLEScan->setAdvertisedDeviceCallbacks(new MyAdvertisedDeviceCallbacks());
  pBLEScan->setActiveScan(true);
  pBLEScan->start(5, false);
}

void loop() {
  server.handleClient();

  if (millis() - lastWiFiCheck >= wifiCheckInterval) {
    lastWiFiCheck = millis();
    if (WiFi.status() != WL_CONNECTED) { WiFi.disconnect(); WiFi.begin(ssid, password); }
  }

  if (WiFi.status() == WL_CONNECTED) {
    if (!mqttClient.connected()) reconnectMQTT();
    mqttClient.loop();
  }

  processSerialInput();

  if (doConnect) {
    isConnected = connectToSensor();
    if (!isConnected) BLEDevice::getScan()->start(5, false);
    doConnect = false;
  }

  if (isConnected && (millis() - lastBleRead > 1500)) {
    lastBleRead = millis();
    if (pClient != nullptr && pClient->isConnected()) {
      float t = bytesToFloat(pTempChar->readValue());
      float h = bytesToFloat(pHumChar->readValue());
      if (!isnan(t) && !isnan(h)) { temperature = t; humidity = h; }
    } else {
      isConnected = false;
      BLEDevice::getScan()->start(5, false);
    }
  }

  if (WiFi.status() == WL_CONNECTED && mqttClient.connected() && (millis() - lastMqttPublish >= mqttPublishInterval)) {
    lastMqttPublish = millis();
    publishSensorData();
  }
}
